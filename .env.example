# Environment variable names read by this application.
# Both are optional overrides of the in-code defaults in
# src/invoice_reconciliation/config.py. Leave unset to use those defaults.
# No API key variable exists: AWS credentials resolve through the standard
# AWS credential chain (SigV4), never from an environment variable here.

# AWS region for the Bedrock call. Default: us-east-1
AWS_REGION=

# Bedrock model ID, including the required "us." inference-profile prefix.
# Default: us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=
